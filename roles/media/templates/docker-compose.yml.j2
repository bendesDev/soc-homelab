# Gerenciado pelo Ansible (roles/media) — não editar à mão.
services:
  jellyfin:
    image: jellyfin/jellyfin:latest
    container_name: jellyfin
    restart: unless-stopped
    user: "{{ media_puid }}:{{ media_pgid }}"
    ports:
      - "{{ jellyfin_port }}:8096"
    volumes:
      - {{ media_config_dir }}/jellyfin:/config
      - {{ media_data_dir }}/library:/data
    devices:
      - {{ jellyfin_render_device }}:{{ jellyfin_render_device }}
    networks:
      - media

  qbittorrent:
    image: lscr.io/linuxserver/qbittorrent:latest
    container_name: qbittorrent
    restart: unless-stopped
    environment:
      - PUID={{ media_puid }}
      - PGID={{ media_pgid }}
      - TZ={{ media_timezone }}
      - WEBUI_PORT={{ qbittorrent_port }}
    ports:
      - "{{ qbittorrent_port }}:{{ qbittorrent_port }}"
      - "{{ qbittorrent_torrenting_port }}:{{ qbittorrent_torrenting_port }}"
      - "{{ qbittorrent_torrenting_port }}:{{ qbittorrent_torrenting_port }}/udp"
    volumes:
      - {{ media_config_dir }}/qbittorrent:/config
      - {{ media_data_dir }}/downloads:/data/downloads
    networks:
      - media

  prowlarr:
    image: lscr.io/linuxserver/prowlarr:latest
    container_name: prowlarr
    restart: unless-stopped
    environment:
      - PUID={{ media_puid }}
      - PGID={{ media_pgid }}
      - TZ={{ media_timezone }}
    ports:
      - "{{ prowlarr_port }}:9696"
    volumes:
      - {{ media_config_dir }}/prowlarr:/config
    networks:
      - media

  sonarr:
    image: lscr.io/linuxserver/sonarr:latest
    container_name: sonarr
    restart: unless-stopped
    environment:
      - PUID={{ media_puid }}
      - PGID={{ media_pgid }}
      - TZ={{ media_timezone }}
    ports:
      - "{{ sonarr_port }}:8989"
    volumes:
      - {{ media_config_dir }}/sonarr:/config
      - {{ media_data_dir }}/downloads:/data/downloads
      - {{ media_data_dir }}/library/tv:/data/library/tv
    networks:
      - media

  radarr:
    image: lscr.io/linuxserver/radarr:latest
    container_name: radarr
    restart: unless-stopped
    environment:
      - PUID={{ media_puid }}
      - PGID={{ media_pgid }}
      - TZ={{ media_timezone }}
    ports:
      - "{{ radarr_port }}:7878"
    volumes:
      - {{ media_config_dir }}/radarr:/config
      - {{ media_data_dir }}/downloads:/data/downloads
      - {{ media_data_dir }}/library/movies:/data/library/movies
    networks:
      - media

  bazarr:
    image: lscr.io/linuxserver/bazarr:latest
    container_name: bazarr
    restart: unless-stopped
    environment:
      - PUID={{ media_puid }}
      - PGID={{ media_pgid }}
      - TZ={{ media_timezone }}
    ports:
      - "{{ bazarr_port }}:6767"
    volumes:
      - {{ media_config_dir }}/bazarr:/config
      - {{ media_data_dir }}/library/movies:/data/library/movies
      - {{ media_data_dir }}/library/tv:/data/library/tv
    networks:
      - media

  flaresolverr:
    image: ghcr.io/flaresolverr/flaresolverr:latest
    container_name: flaresolverr
    restart: unless-stopped
    environment:
      - LOG_LEVEL=info
      - TZ={{ media_timezone }}
    ports:
      - "{{ flaresolverr_port }}:8191"
    networks:
      - media

  jellyseerr:
    image: fallenbagel/jellyseerr:latest
    container_name: jellyseerr
    restart: unless-stopped
    environment:
      - TZ={{ media_timezone }}
    ports:
      - "{{ jellyseerr_port }}:5055"
    volumes:
      - {{ media_config_dir }}/jellyseerr:/app/config
    networks:
      - media

  # Readarr foi oficialmente aposentado pelo time do Servarr em 2026 — o
  # backend de metadados (api.bookinfo.club) morreu de vez (NXDOMAIN,
  # confirmado até em DNS público) e não vai ser consertado. Chaptarr é
  # o fork ativo que assumiu o projeto: junta ebooks E audiobooks numa
  # instância só, mantém a mesma API v1 (por isso continua registrado no
  # Prowlarr como "Readarr" — o Prowlarr desta versão ainda não tem uma
  # implementação nativa "Chaptarr", mas o contrato da API é o mesmo).
  chaptarr:
    image: chaptarr/chaptarr:latest
    container_name: chaptarr
    restart: unless-stopped
    environment:
      - PUID={{ media_puid }}
      - PGID={{ media_pgid }}
      - TZ={{ media_timezone }}
    ports:
      - "{{ chaptarr_port }}:8789"
    volumes:
      - {{ media_config_dir }}/chaptarr:/config
      - {{ media_data_dir }}/downloads:/downloads
      - {{ media_data_dir }}/library/books:/ebooks
      - {{ media_data_dir }}/library/audiobooks:/audiobooks
    networks:
      - media

  audiobookshelf:
    image: ghcr.io/advplyr/audiobookshelf:latest
    container_name: audiobookshelf
    restart: unless-stopped
    environment:
      - AUDIOBOOKSHELF_UID={{ media_puid }}
      - AUDIOBOOKSHELF_GID={{ media_pgid }}
      - TZ={{ media_timezone }}
    ports:
      - "{{ audiobookshelf_port }}:80"
    volumes:
      - {{ media_config_dir }}/audiobookshelf/config:/config
      - {{ media_config_dir }}/audiobookshelf/metadata:/metadata
      - {{ media_data_dir }}/library/audiobooks:/audiobooks
    networks:
      - media

networks:
  media:
    name: {{ media_docker_network }}
