# Gerenciado pelo Ansible (roles/windows_vm) — não editar à mão.
services:
  windows:
    image: dockurr/windows
    container_name: {{ item.name }}
    environment:
      VERSION: "{{ item.version }}"
      RAM_SIZE: "{{ item.ram_size }}"
      CPU_CORES: "{{ item.cpu_cores }}"
      DISK_SIZE: "{{ item.disk_size }}"
    devices:
      - /dev/kvm
      - /dev/net/tun
    cap_add:
      - NET_ADMIN
    ports:
      - "127.0.0.1:{{ item.vnc_port }}:8006"
      - "{{ item.rdp_port }}:3389/tcp"
      - "{{ item.rdp_port }}:3389/udp"
    volumes:
      - windows_data:/storage
    networks:
      - pentest
    restart: always
    stop_grace_period: 2m

networks:
  pentest:
    external: true
    name: {{ pentest_network_name }}

volumes:
  windows_data:
